' ===== STUDENT USE CASES TEST CASES =====
package "Student Use Cases - Core Actions" {
  table "Registration Test Cases" {
    Test Case | Input | Expected Output | Status
    Valid Registration | email, username, password | 201 Created, user account | Pending
    Duplicate Email | existing email, new username, password | 400 Bad Request, error message | Pending
    Duplicate Username | new email, existing username, password | 400 Bad Request, error message | Pending
    Invalid Email Format | invalid email, username, password | 400 Bad Request, validation error | Pending
    Weak Password | email, username, weak password | 400 Bad Request, password requirements | Pending
    Missing Required Fields | partial data | 400 Bad Request, missing field errors | Pending
  }
  
  table "Login Test Cases" {
    Test Case | Input | Expected Output | Status
    Valid Login | correct email, correct password | 200 OK, user data + token | Pending
    Invalid Email | wrong email, correct password | 401 Unauthorized | Pending
    Invalid Password | correct email, wrong password | 401 Unauthorized | Pending
    Account Not Found | non-existent email, password | 401 Unauthorized | Pending
    Account Locked | locked account credentials | 423 Locked | Pending
    Too Many Attempts | multiple failed attempts | 429 Too Many Requests | Pending
  }
}

