@startuml Admin Use Cases Activity Diagrams

!theme plain
skinparam backgroundColor #FFFFFF
skinparam activity {
    BackgroundColor #FDF6E8
    BorderColor #E67E22
    FontColor #2C3E50
}
skinparam activityDiamond {
    BackgroundColor #F9E79F
    BorderColor #B9770E
    FontColor #2C3E50
}

' ========================================
' 1. ADMIN LOGIN ACTIVITY DIAGRAM
' ========================================
title Admin Login Activity Diagram

|Admin|
start
:Navigate to login page;
:Enter admin credentials;
:Submit login form;

|System|
:Validate admin credentials;
if (Credentials valid?) then (yes)
    :Generate authentication token;
    :Store admin session;
    :Redirect to admin dashboard;
    |Admin|
    :Access admin dashboard;
    stop
else (no)
    :Display error message;
    |Admin|
    :View error message;
    :Retry login;
    stop
endif

' ========================================
' 2. VIEW ANALYTICS ACTIVITY DIAGRAM
' ========================================
newpage
title View Analytics Activity Diagram

|Admin|
start
:Navigate to analytics page;

|System|
:Fetch analytics data (user stats, course stats, etc.);
:Process and aggregate data;
:Display analytics dashboard;

|Admin|
:View analytics charts and reports;
:Filter or export data;
stop

