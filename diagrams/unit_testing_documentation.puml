@startuml Unit Testing Documentation

!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 12

title Unit Testing Documentation - Educational Game System

' ===== TESTING FRAMEWORK SETUP =====
package "Testing Framework" {
  class "Jest" {
    + describe()
    + it()
    + expect()
    + beforeEach()
    + afterEach()
  }
  
  class "Testing Library" {
    + render()
    + screen.getByText()
    + fireEvent.click()
    + waitFor()
  }
  
  class "MSW (Mock Service Worker)" {
    + setupServer()
    + rest.get()
    + rest.post()
  }
}

' ===== AUTHENTICATION TESTS =====
package "Authentication Tests" {
  class "AuthService Tests" {
    + testAuthenticateUser()
    + testGenerateToken()
    + testVerifyToken()
    + testInvalidCredentials()
    + testExpiredToken()
  }
  
  class "Login API Tests" {
    + testSuccessfulLogin()
    + testInvalidCredentials()
    + testMissingFields()
    + testDatabaseConnectionFailure()
  }
  
  class "Token Verification Tests" {
    + testValidToken()
    + testInvalidToken()
    + testExpiredToken()
    + testMissingToken()
  }
}

